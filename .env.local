# ==========================================================
# KONFIGURASI ENVIRONMENT CIPUY AI
# Salin file ini menjadi .env.local dan isi nilai di bawah ini:
# ==========================================================

# 1. SUPABASE (Dapatkan dari Dashboard Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. GOOGLE GEMINI API (Dapatkan gratis dari https://aistudio.google.com/)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# 3. URL APLIKASI
NEXT_PUBLIC_APP_URL=http://localhost:3000

